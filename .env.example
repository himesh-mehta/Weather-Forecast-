# Copy to .env and fill in what you have. Every provider is optional: a provider whose key is
# empty is skipped and shown on the dashboard as "no API key in .env".
# NEVER commit .env (it is in .gitignore). Share keys through a password manager, not chat/email.

# --- Kill switch ----------------------------------------------------------------------------
# 1 = stop ALL outbound API calls (scheduler, dashboard on-demand fetches, CLI). Saved data is
# still served. 0 = normal operation. The project was handed over with fetching PAUSED.
FETCH_PAUSED=1

# --- Commercial / keyed weather APIs (see README "Providers") --------------------------------
WEATHERAPI_KEY=
OPENWEATHER_KEY=
VISUAL_CROSSING_KEY=
TOMORROW_IO_KEY=
WEATHERBIT_KEY=
METEOSOURCE_KEY=
ACCUWEATHER_KEY=
METEOBLUE_KEY=
WINDY_KEY=
# Windy free "testing" keys return deliberately shuffled data. 1 = treat as trial (excluded from
# consensus), 0 = paid key.
WINDY_TRIAL=1
STORMGLASS_KEY=
AMBEE_KEY=
GOOGLE_WEATHER_KEY=
APPLE_WEATHERKIT_JWT=
METOFFICE_DATAHUB_KEY=
# Xweather needs both halves (Xweather account > Apps)
XWEATHER_CLIENT_ID=
XWEATHER_CLIENT_SECRET=
WEATHER_UNION_KEY=
FORECA_KEY=

# --- Not used by the code yet ---------------------------------------------------------------
FARMONAUT_KEY=
# Postgres URL for a future migration (db_schema.sql); the app uses SQLite today.
DATABASE_URL=

# --- Security (all optional; defaults are right for running on one PC) -----------------------
# Extra host names the server answers to, e.g. your domain when deployed (comma-separated)
ALLOWED_HOSTS=
# Other websites allowed to call the API from a browser (default: none = same-origin only)
ALLOWED_ORIGINS=
# Secret for admin endpoints (/api/usage, full /api/runs) via the X-Admin-Key header.
# If empty, admin endpoints only answer requests from the machine itself.
ADMIN_KEY=
# 1 when running behind a reverse proxy (Nginx/Caddy/Cloudflare) that sets X-Forwarded-For/Proto
TRUST_PROXY=0
# 1 to expose interactive API docs at /docs
ENABLE_API_DOCS=0
